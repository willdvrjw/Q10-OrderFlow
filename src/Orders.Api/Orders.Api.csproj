<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <ProjectReference Include="../OrderFlow.Contracts/OrderFlow.Contracts.csproj" />
    <ProjectReference Include="../OrderFlow.Messaging/OrderFlow.Messaging.csproj" />
  </ItemGroup>
  <!-- El catálogo de muestra viaja junto con la aplicación al compilar o publicar. -->
  <ItemGroup>
    <Content Include="../../seed/products.json" Link="seed/products.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
