# Archivo de ejemplo. Para la prueba local no es obligatorio crear .env:
# docker compose up usa valores de demostración definidos en compose.yaml.
# Nunca almacenar contraseñas reales aquí ni publicar un .env privado.
ORDERFLOW_PG_PASSWORD=replace_with_local_development_password
ORDERFLOW_RMQ_PASSWORD=replace_with_local_development_password

# Opcional: solo cambia el puerto del navegador, no los de las API internas.
# Si 8080 ya está ocupado, usa por ejemplo 8090.
ORDERFLOW_WEB_PORT=8080
